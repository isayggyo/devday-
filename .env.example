APP_ENV=development
AUTH_MODE=development
DATABASE_URL=postgresql+psycopg://lecture:replace-with-local-password@127.0.0.1:55432/lecture_dev
TEST_DATABASE_URL=postgresql+psycopg://lecture:replace-with-local-password@127.0.0.1:55432/lecture_test
FRONTEND_ORIGIN=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:8000
# Backend only. Never use a NEXT_PUBLIC_ variable for an API key.
OPENAI_API_KEY=
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=lecture-dev
S3_TEST_BUCKET=lecture-test
MATERIAL_MAX_BYTES=31457280
MATERIAL_MAX_PAGES=200
STT_MODEL=gpt-live-transcribe
GENERATION_MODEL=gpt-6-luna
NOTE_MIN_SEGMENTS=2
NOTE_INTERVAL_SECONDS=20
# Question-time confirmed transcript window: 120-300 seconds.
CONTEXT_WINDOW_SECONDS=180
